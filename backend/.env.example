# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/workout_app

# Cloudinary (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CORS (frontend dev URL)
FRONTEND_ORIGIN=http://localhost:5173

# Optional: tweak default plan
DEFAULT_PLAN_WEEKS=12

# Observability + safety
LOG_LEVEL=INFO
MAX_UPLOAD_MB=10

# docker-compose (used by the `db` service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=workout_app
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=8080
